# Screen2Social local settings.
# This file is documentation only; Screen2Social does not auto-load .env files.

# V0.2 OBS WebSocket settings.
SCREEN2SOCIAL_OBS_HOST=localhost
SCREEN2SOCIAL_OBS_PORT=4455
SCREEN2SOCIAL_OBS_PASSWORD=
SCREEN2SOCIAL_OBS_TIMEOUT_SECONDS=5.0

# V0.4 optional local transcription settings.
# Required only when `screen2social process ... --transcribe` is used.
SCREEN2SOCIAL_WHISPER_CLI=
SCREEN2SOCIAL_WHISPER_MODEL=
